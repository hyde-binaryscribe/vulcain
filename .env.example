APP_NAME=Vulcain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# SaaS multi-tenant : domaine racine servant de base aux sous-domaines par organisation
# ex. : caserne.vulcain.test -> organisation "caserne"
APP_CENTRAL_DOMAIN=localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Hachage des mots de passe : Argon2id (exigence du cahier des charges)
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=4
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=vulcain
DB_USERNAME=vulcain
DB_PASSWORD=secret

# Sessions en base (permet la révocation des sessions actives, exigence du cahier)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies durcis (mettre true derrière HTTPS en production)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Fichiers privés stockés hors du dossier web public (voir config/filesystems.php : disque "private")
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@vulcain.test"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage objet S3-compatible (optionnel — pour les fichiers privés à l'échelle SaaS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Port exposé par docker compose (environnement de test local)
APP_PORT=8080

VITE_APP_NAME="${APP_NAME}"
