APP_NAME=Vulkain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# SaaS multi-tenant : domaine racine servant de base aux sous-domaines par organisation
# ex. : caserne.vulcain.test -> organisation "caserne"
APP_CENTRAL_DOMAIN=localhost

# Répartition des hôtes en production (séparation stricte par hôte) :
#   APP_CENTRAL_DOMAIN=vulkain.eu,www.vulkain.eu,desk.vulkain.eu,app.vulkain.eu
#   APP_VITRINE_DOMAIN=vulkain.eu,www.vulkain.eu   # site vitrine public
#   APP_APP_DOMAIN=app.vulkain.eu                   # ESPACE CLIENT (login/inscription/dashboard/métier)
#   APP_DESK_DOMAIN=desk.vulkain.eu                 # DESK management (jamais accessible aux clients)
# Accès par compte (hôte unique app) ; le client n'accède qu'à l'app, le Desk qu'à desk.
# APP_DESK_DOMAIN dispose d'un repli (central - vitrine - app) s'il n'est pas défini.
APP_VITRINE_DOMAIN=
APP_APP_DOMAIN=
APP_DESK_DOMAIN=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Hachage des mots de passe : Argon2id (exigence du cahier des charges)
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=4
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=vulcain
DB_USERNAME=vulcain
DB_PASSWORD=secret

# Sessions en base (permet la révocation des sessions actives, exigence du cahier)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies durcis (mettre true derrière HTTPS en production)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Fichiers privés stockés hors du dossier web public (voir config/filesystems.php : disque "private")
FILESYSTEM_DISK=local
# Pas de Redis (mutualisé Plesk) : file d'attente synchrone (notifications
# envoyées dans la requête) et cache en base. Un .env qui pointe vers Redis
# provoque une 500 en production. Voir docs/DEPLOIEMENT-PLESK.md §6.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail — invitations, réinitialisation de mot de passe, décisions de congés.
# En local : "log" écrit les messages dans storage/logs sans rien envoyer.
# En production (boîte Plesk du domaine), passer en SMTP :
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.vulkain.eu      # nom d'hôte du serveur mail Plesk (cert TLS valide)
#   MAIL_PORT=587                  # STARTTLS ; ou 465 avec MAIL_SCHEME=smtps
#   MAIL_SCHEME=smtp               # smtp = STARTTLS (587), smtps = TLS implicite (465)
#   MAIL_USERNAME=no-reply@vulkain.eu
#   MAIL_PASSWORD=<mot de passe de la boîte>
# Vérifier ensuite avec : php artisan vulcain:mail-test vous@exemple.fr
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=mail.vulkain.eu
MAIL_PORT=587
MAIL_USERNAME=no-reply@vulkain.eu
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@vulkain.eu"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage objet S3-compatible (optionnel — pour les fichiers privés à l'échelle SaaS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Port exposé par docker compose (environnement de test local)
APP_PORT=8080

VITE_APP_NAME="${APP_NAME}"
